<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Texto visible en el botón -->
    <add key="ButtonCaption" value="Autoasignar Todo" />
    
    <!-- Ancho del botón en píxeles -->
    <add key="ButtonWidth" value="140" />

    <!-- Si es true, además de autoasignar todas las líneas, presiona 'Actualizar' (Item 1) automáticamente -->
    <add key="AutoConfirm" value="true" />

    <!-- Habilitar también en la ventana de Números de Serie (Formulario 41) -->
    <add key="EnableSerials" value="true" />
  </appSettings>
</configuration>
